        "label": "Age",
        "type": "number",
        "min": 18,
        "max": 120,
        "unit": "years",
        "step": 1,
        "optional": false
      },
      {
        "id": "bmi",
        "label": "Body mass index",
        "type": "number",
        "min": 10,
        "max": 100,
        "unit": "kg/m²",
        "step": "any",
        "optional": false
      },
      {
        "id": "af",
        "label": "History of atrial fibrillation",
        "options": [
          {
            "value": 0,
            "label": "No"
          },
          {
            "value": 1,
            "label": "Yes"
          }
        ],
        "help": "Paroxysmal, persistent or permanent AF."
      }
    ],
    "references": [
      {
        "label": "Reddy et al., Nature Medicine (2024), Extended Data Table 4",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11570987/"
      }
    ],
    "note": "Screening model for ambulatory adults with dyspnea. Echocardiography and evaluation for alternative causes remain necessary. The percentage is a model estimate, not a confirmed diagnosis.",
    "method": "Log odds = −7.788751 + 0.062564 × age + 0.135149 × BMI + 2.040806 × AF (1 if present, otherwise 0). Probability = 100 / (1 + exp(−log odds))."
  },
